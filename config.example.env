# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Кому разрешено пользоваться ботом: Telegram ID и/или @username через запятую.
# Пусто — бот доступен всем. Свой ID бот покажет при попытке входа без доступа.
ALLOWED_USERS=

# Прокси для Telegram, например http://user:pass@host:3128 (необязательно)
TELEGRAM_PROXY=

# Таймаут одного запроса к НСПД, сек
NSPD_TIMEOUT=15
# Число попыток при таймаутах и сбоях НСПД
NSPD_RETRIES=3
# Сколько запросов к НСПД выполнять одновременно
NSPD_CONCURRENCY=4
# Время жизни кэша ответов НСПД, мин (0 — без кэша)
CACHE_TTL_MINUTES=30
# Максимум номеров в одном сообщении
MAX_BATCH=20

LOG_LEVEL=INFO
